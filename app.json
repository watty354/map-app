{
  "expo": {
    "name": "nominau",
    "slug": "map-app",
    "version": "1.0.5",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "サービス提供のために位置情報が使用されます",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "サービス提供のために常に位置情報が使用されます"
      },
      "bundleIdentifier": "com.wadamitsuki.mapapp",
      "buildNumber": "6"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.wadamitsuki.mapapp"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "0a7f9752-18ea-44ea-8898-735e7d5d0788"
      }
    }
  }
}
